# Variáveis de ambiente do portal — cadastrar na Vercel (Settings › Environment
# Variables) e, para rodar no Mac, num .env.local (que NÃO vai para o GitHub).

# Supabase (Project Settings › API) — projeto PRÓPRIO deste portal, região sa-east-1
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só o servidor usa (Admin de usuários e Cadastros). NUNCA no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Consulta CPF (Serpro, Consulta CPF v3) — chaves do contrato na Área do Cliente
# do Serpro. Sem elas, o card abre e avisa que falta configurar.
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
